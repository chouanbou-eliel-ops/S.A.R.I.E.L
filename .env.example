# Clé API du fournisseur LLM choisi (Anthropic, OpenAI, etc.)
LLM_API_KEY=your_api_key_here

# Clé API Tavily (recherche web) — https://app.tavily.com
TAVILY_API_KEY=your_tavily_key_here

# Modèle utilisé (ex. claude-haiku-4-5-20251001)
LLM_MODEL=

# Chemin du fichier de mémoire persistante
MEMORY_PATH=data/memory.json

# Niveau de verbosité (true/false) — affiche les appels de tools bruts
VERBOSE=false
